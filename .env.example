# Copy to .env for local development. Placeholders only; never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Required in production; generate with: openssl rand -hex 32
SECRET_KEY=change-me
POSTGRES_USER=medicompare
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=medicompare
DATABASE_URL=postgresql+psycopg://medicompare:change-me-postgres@localhost:5433/medicompare
TEST_DATABASE_URL=postgresql+psycopg://medicompare:change-me-postgres@localhost:5433/medicompare_test
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=change-me-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=medicompare-prescriptions
S3_REGION=ap-south-1
# Days an upload is kept before the retention job deletes it.
RETENTION_DAYS=7
# ocr: tesseract | rapidocr
OCR_ENGINE=tesseract
# Optional LLM extraction adapter. Disabled by default; see docs/AI_OCR_DESIGN.md.
LLM_EXTRACTION_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
# Optional malware scan hook, e.g. clamav:3310. Empty disables scanning (development only).
CLAMAV_ADDRESS=
COOKIE_SECURE=false
LOG_LEVEL=INFO
