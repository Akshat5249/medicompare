# Test and evaluation image: the backend image plus dev tools, with Tesseract available.
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH MPLCONFIGDIR=/tmp/mpl
RUN pip install --no-cache-dir uv==0.11.21 && apt-get update && apt-get install -y --no-install-recommends tesseract-ocr libgl1 libglib2.0-0 fonts-dejavu-core
WORKDIR /srv/medicompare/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project
